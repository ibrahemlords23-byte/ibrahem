    "express-validator": "^7.0.1",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "pdfkit": "^0.14.0",
    "nodemailer": "^6.9.7",
    "firebase-admin": "^11.11.1",
    "moment": "^2.29.4",
    "uuid": "^9.0.1"
